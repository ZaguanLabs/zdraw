name=zdraw
link='if test "x$ac_cv_func_initscr" = xyes && test "x$zsh_cv_path_curses_header" != x; then echo dynamic; else echo no; fi'
load=no

autofeatures="b:zdraw"

objects="zdraw.o"

:<<\Make
zdraw.o zdraw..o: zdraw_keys.h $(sdir)/zdraw_grapheme.h $(sdir)/zdraw_grapheme_data.h $(sdir)/zdraw_raster.h

zdraw_keys.h: zdraw_keys.awk @CURSES_KEYS_H@
	$(AWK) -f $(sdir)/zdraw_keys.awk @CURSES_KEYS_H@ /dev/null >zdraw_keys.h

clean-here: clean.zdraw
clean.zdraw:
	rm -f zdraw_keys.h
Make
