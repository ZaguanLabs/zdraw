xitem(tt(zdraw) tt(string) var(targetwin) var(string) [ tt(policy=)var(policy) ] )
xitem(tt(zdraw) tt(spans) var(targetwin) var(row) var(column) [ tt(policy=)var(policy) ] var(style) var(text) [ var(style) var(text) ... ] )
xitem(tt(zdraw) tt(prepare) var(name) var(style) var(text) [ var(style) var(text) ... ] )
xitem(tt(zdraw) tt(draw) var(targetwin) var(row) var(column) var(name) [ var(columns) ] )
