COMMENT(!MOD!zdraw
curses windowing commands
!MOD!)
The tt(zdraw) module provides terminal drawing and interaction through one
builtin command and various parameters. It is independently developed from
tt(zsh/curses), with inherited operations exposed under the tt(zdraw) name.
The stock tt(zsh/curses) module remains separate; no tt(zcurses) aliases are
registered. Use only one active curses owner in a process, ending and unloading
it before switching modules.

subsect(Builtin)

startitem()
findex(zdraw)
cindex(windows, curses)
xitem(tt(zdraw) tt(init))
xitem(tt(zdraw) tt(end))
xitem(tt(zdraw) tt(addwin) var(targetwin) var(nlines) var(ncols) var(begin_y) var(begin_x) [ var(parentwin) ] )
xitem(tt(zdraw) tt(movewin) var(targetwin) var(row) var(column))
xitem(tt(zdraw) tt(resizewin) var(targetwin) var(rows) var(columns) [ var(row) var(column) ])
xitem(tt(zdraw) tt(addpad) var(name) var(rows) var(columns))
xitem(tt(zdraw) tt(resizepad) var(pad) var(rows) var(columns))
xitem(tt(zdraw) tt(viewport) var(pad) var(pad_row) var(pad_column) var(screen_row) var(screen_column) var(rows) var(columns))
xitem(tt(zdraw) tt(stage) var(targetwin) [ var(targetwin) ... ])
xitem(tt(zdraw) tt(present))
xitem(tt(zdraw) tt(treewin) var(targetwin) var(rows) var(columns) var(row) var(column))
xitem(tt(zdraw) tt(sync) tt(on)|tt(off))
xitem(tt(zdraw) tt(delwin) var(targetwin) )
xitem(tt(zdraw) tt(refresh) [ var(targetwin) ... ] )
xitem(tt(zdraw) tt(touch) var(targetwin) ...)
xitem(tt(zdraw) tt(move) var(targetwin) var(new_y) var(new_x) )
xitem(tt(zdraw) tt(clear) var(targetwin) [ tt(redraw) | tt(eol) | tt(bot) ])
xitem(tt(zdraw) tt(position) var(targetwin) var(array))
xitem(tt(zdraw) tt(geometry) var(array))
xitem(tt(zdraw) tt(colorinfo) var(association))
xitem(tt(zdraw) tt(resourceinfo) var(association))
xitem(tt(zdraw) tt(raster) var(operation) var(name) [ var(arguments) ... ])
xitem(tt(zdraw) tt(textinfo) var(association) var(text) [ var(columns) [ var(policy) ] ])
xitem(tt(zdraw) tt(textpos) var(association) var(text) tt(column)|tt(byte) var(offset) [ var(policy) ])
xitem(tt(zdraw) tt(textpolicy) var(association) [ var(policy) ])
xitem(tt(zdraw) tt(textwrap) var(association) var(text) var(columns))
xitem(tt(zdraw) tt(truecolor) tt(on)|tt(off))
