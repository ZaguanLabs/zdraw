xitem(tt(zdraw) tt(keyboard) tt(on)|tt(off))
xitem(tt(zdraw) tt(inputdelay) var(milliseconds))
xitem(tt(zdraw) tt(spansclip) var(targetwin) var(row) var(column) var(columns) [ tt(policy=)var(policy) ] var(style) var(text) [ var(style) var(text) ... ] )
xitem(tt(zdraw) tt(border) var(targetwin) [ var(left) var(right) var(top) var(bottom) var(top_left) var(top_right) var(bottom_left) var(bottom_right) ] )
xitem(tt(zdraw) tt(attr) var(targetwin) [ [tt(+)|tt(-)]var(attribute) | var(fg_col)tt(/)var(bg_col) ] [...])
xitem(tt(zdraw) tt(bg) var(targetwin) [ [tt(+)|tt(-)]var(attribute) | var(fg_col)tt(/)var(bg_col) | tt(@)var(char) ] [...])
xitem(tt(zdraw) tt(scroll) var(targetwin) [ tt(on) | tt(off) | [tt(+)|tt(-)]var(lines) ])
